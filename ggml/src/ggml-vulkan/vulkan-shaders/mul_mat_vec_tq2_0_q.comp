#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"
#include "mul_mmq_funcs.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// Inline body for processing ONE K-block at index `i`, accumulating into
// temp[jcol][0..num_rows-1]. Kept as a function so we can call it twice in
// succession to manually unroll the K-block loop (software pipelining): the
// two back-to-back calls give the compiler a single fat basic block with two
// blocks' worth of independent memory issues, which it can interleave with
// each other's ALU to fill the ~36% ALU idle / ~50% LSU idle headroom.
void process_kblock(
    const uint  i,
    const uint  jcol,
    const uint  b_base,
    const uint  b_offset,
    const uint  ib0_base,
    const uint  num_rows,
    const uint  num_blocks_per_row,
    const uint  k,
    const uint  vec_idx
) {
    [[unroll]] for (uint h = 0; h < 2; ++h) {
        const uint j = h * 32u;

        // ---------------- B: loaded once, shared across rows ----------------
        const uint b_first = b_offset + (b_base + i * QUANT_K + j * 4u) / QUANT_K_Q8_1;
        const uint b_outer = b_first / 4u;

        const vec2 ds0 = vec2(data_b[b_offset + b_outer].ds[0]);
        const vec2 ds1 = vec2(data_b[b_offset + b_outer].ds[1]);
        const vec2 ds2 = vec2(data_b[b_offset + b_outer].ds[2]);
        const vec2 ds3 = vec2(data_b[b_offset + b_outer].ds[3]);

        const int32_t b0 = data_b[b_offset + b_outer].qs[0u * 8u + vec_idx];
        const int32_t b1 = data_b[b_offset + b_outer].qs[1u * 8u + vec_idx];
        const int32_t b2 = data_b[b_offset + b_outer].qs[2u * 8u + vec_idx];
        const int32_t b3 = data_b[b_offset + b_outer].qs[3u * 8u + vec_idx];

        // ---------------- Per-row A + compute ----------------
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            if (n >= num_rows) { continue; }

            const uint  ib0    = ib0_base + n * num_blocks_per_row;
            const float d      =  float(data_a[ib0 + i].d);
            const float d_neg8 = -d * 0.125f;

            const uint a_h_idx = (j + k) >> 1u;
            const uint a_lo    = uint(data_a_packed16[ib0 + i].qs[a_h_idx    ]);
            const uint a_hi    = uint(data_a_packed16[ib0 + i].qs[a_h_idx + 1]);
            const uint v       = a_lo | (a_hi << 16);

            const int32_t a0 = int32_t( v         & 0x03030303u);
            const int32_t a1 = int32_t((v >> 2u)  & 0x03030303u);
            const int32_t a2 = int32_t((v >> 4u)  & 0x03030303u);
            const int32_t a3 = int32_t((v >> 6u)  & 0x03030303u);

            FLOAT_TYPE acc = temp[jcol][n];
            acc += ACC_TYPE(float(dotPacked4x8EXT(a0, b0)) * d * ds0.x + d_neg8 * ds0.y);
            acc += ACC_TYPE(float(dotPacked4x8EXT(a1, b1)) * d * ds1.x + d_neg8 * ds1.y);
            acc += ACC_TYPE(float(dotPacked4x8EXT(a2, b2)) * d * ds2.x + d_neg8 * ds2.y);
            acc += ACC_TYPE(float(dotPacked4x8EXT(a3, b3)) * d * ds3.x + d_neg8 * ds3.y);
            temp[jcol][n] = acc;
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    const uint tid     = gl_LocalInvocationID.x;
    const uint k       = (tid % 8) * 4;   // byte offset inside a 32-byte half
    const uint vec_idx = k / 4;           // 0..7 -> qs[8] of an inner B sub-block

    const uint ib0_base = a_offset / QUANT_K + first_row * num_blocks_per_row;
    const uint stride   = gl_WorkGroupSize.x / 8u;

    for (uint jcol = 0; jcol < NUM_COLS; jcol++) {
        const uint b_base = (jcol * p.batch_stride_b);

        // Manually unroll the K-block loop by 2. Block `i` and block
        // `i + stride` have fully independent A and B addresses, so the
        // compiler can freely interleave their loads and ALU to fill the
        // LSU/ALU idle headroom the profile shows after the occupancy fix.
        uint i = tid / 8;
        for (; i + stride < num_blocks_per_row; i += 2u * stride) {
            process_kblock(i,          jcol, b_base, b_offset, ib0_base, num_rows, num_blocks_per_row, k, vec_idx);
            process_kblock(i + stride, jcol, b_base, b_offset, ib0_base, num_rows, num_blocks_per_row, k, vec_idx);
        }
        // Tail: at most one remaining block per thread.
        if (i < num_blocks_per_row) {
            process_kblock(i,          jcol, b_base, b_offset, ib0_base, num_rows, num_blocks_per_row, k, vec_idx);
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
