#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"
#include "mul_mmq_funcs.comp"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    const uint tid = gl_LocalInvocationID.x;
    const uint k   = (tid % 8) * 4;   // byte offset inside a 32-byte half
    const uint vec_idx = k / 4;       // 0..7, into qs[8] of an inner B sub-block

    // Precompute the A-row base offsets up to NUM_ROWS once, so we can unroll
    // the per-row inner loop and keep `temp[jcol][n]` in registers.
    uint ib0_row[NUM_ROWS];
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        ib0_row[n] = a_offset / QUANT_K + (first_row + n) * num_blocks_per_row;
    }

    for (uint jcol = 0; jcol < NUM_COLS; jcol++) {
        const uint b_base = (jcol * p.batch_stride_b);

        // Loop order: i (K-block) outermost, then row n innermost. This lets
        // us load each block_q8_1_x4 of B exactly ONCE per K-block and reuse
        // it across all `num_rows` rows handled by this workgroup (NUM_ROWS=2
        // on Adreno), halving B-side LSU traffic.
        for (uint i = tid/8; i < num_blocks_per_row; i += gl_WorkGroupSize.x/8) {
            // Each K=256 block has two "halves" (j=0 and j=32). Each half's
            // four shift levels (0/2/4/6) map 1:1 to the four inner
            // sub-blocks of ONE block_q8_1_x4 -> we can amortize B loads.
            [[unroll]] for (uint h = 0; h < 2; ++h) {
                const uint j = h * 32u;

                // ---------------- B: load once, reuse across rows ----------------
                // b_first is the first inner-block index (a multiple of 4 because
                // j*4 is a multiple of QUANT_K_Q8_1 * 4), so b_outer = b_first / 4.
                // Addressing mirrors mul_mat_vec_tq1_0_q.comp so that semantics
                // match the original shader for every call site.
                const uint b_first = b_offset + (b_base + i * QUANT_K + j * 4u) / QUANT_K_Q8_1;
                const uint b_outer = b_first / 4u;

                // Pack all four (ds.x, ds.y) pairs into vec4s so the compiler
                // can emit two wide FP16->FP32 loads instead of four scalar ones
                // and schedule the scaling as vec4 FMAs later.
                const vec2 ds0v = vec2(data_b[b_offset + b_outer].ds[0]);
                const vec2 ds1v = vec2(data_b[b_offset + b_outer].ds[1]);
                const vec2 ds2v = vec2(data_b[b_offset + b_outer].ds[2]);
                const vec2 ds3v = vec2(data_b[b_offset + b_outer].ds[3]);

                const vec4 ds_x = vec4(ds0v.x, ds1v.x, ds2v.x, ds3v.x);
                const vec4 ds_y = vec4(ds0v.y, ds1v.y, ds2v.y, ds3v.y);

                const int32_t b0 = data_b[b_offset + b_outer].qs[0u * 8u + vec_idx];
                const int32_t b1 = data_b[b_offset + b_outer].qs[1u * 8u + vec_idx];
                const int32_t b2 = data_b[b_offset + b_outer].qs[2u * 8u + vec_idx];
                const int32_t b3 = data_b[b_offset + b_outer].qs[3u * 8u + vec_idx];

                // ---------------- Per-row A + compute ----------------
                // [[unroll]] over the compile-time NUM_ROWS bound with a runtime
                // `n < num_rows` guard lets the compiler register-allocate
                // `temp[jcol][n]` (constant index per unrolled iteration) while
                // still handling the boundary case where the last workgroup has
                // fewer rows than NUM_ROWS.
                [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                    if (n >= num_rows) { continue; }

                    const uint  ib0    = ib0_row[n];
                    const float d      =  float(data_a[ib0 + i].d);
                    // Fuse   d * (q*ds.x)   and   -d*(1/8) * ds.y    into vec4 FMAs.
                    const vec4  d_x    = ds_x * d;
                    const vec4  d_neg8_y = ds_y * (-d * 0.125f);

                    // Load 4 A-bytes via two aligned uint16 reads; derive all
                    // four shift levels (= 4 ternary-packed lane vectors) from
                    // one uint.
                    const uint a_h_idx = (j + k) >> 1u;
                    const uint a_lo    = uint(data_a_packed16[ib0 + i].qs[a_h_idx    ]);
                    const uint a_hi    = uint(data_a_packed16[ib0 + i].qs[a_h_idx + 1]);
                    const uint v       = a_lo | (a_hi << 16);

                    const int32_t a0 = int32_t( v         & 0x03030303u);
                    const int32_t a1 = int32_t((v >> 2u)  & 0x03030303u);
                    const int32_t a2 = int32_t((v >> 4u)  & 0x03030303u);
                    const int32_t a3 = int32_t((v >> 6u)  & 0x03030303u);

                    // 4 FMAs, indexed into pre-scaled vec4s.
                    FLOAT_TYPE acc = temp[jcol][n];
                    acc += ACC_TYPE(float(dotPacked4x8EXT(a0, b0)) * d_x.x + d_neg8_y.x);
                    acc += ACC_TYPE(float(dotPacked4x8EXT(a1, b1)) * d_x.y + d_neg8_y.y);
                    acc += ACC_TYPE(float(dotPacked4x8EXT(a2, b2)) * d_x.z + d_neg8_y.z);
                    acc += ACC_TYPE(float(dotPacked4x8EXT(a3, b3)) * d_x.w + d_neg8_y.w);
                    temp[jcol][n] = acc;
                }
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
