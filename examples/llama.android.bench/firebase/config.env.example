# Copy to config.env and fill in your Firebase / GCP project settings.
#   cp config.env.example config.env

# GCP project ID linked to Firebase
GCP_PROJECT_ID=your-firebase-project-id

# GCS bucket for Test Lab results (must exist and be writable)
RESULTS_BUCKET=gs://your-firebase-project-id-test-lab-results

# Default Hugging Face model path in repo (override on command line)
DEFAULT_MODEL_PATH=qwen3-1.7B/Qwen3-1.7B-Q4_K_M.gguf

# llama-bench repetitions for automated runs (keep low for Test Lab timeouts)
DEFAULT_REPETITIONS=5

# Test timeout per device
TEST_TIMEOUT=45m

# Device matrix JSON file (override with --devices or -D on command line)
# DEVICE_MATRIX=firebase/device-matrix.json
